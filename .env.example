# Supabase
# Project Settings → API → Project URL + anon public key (usually starts with eyJ...)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: set to true ONLY after cms_* tables + storage SQL work (enables remote DB sync)
# Leave false/empty so the public website stays fast (local CMS + Storage URLs).
VITE_SUPABASE_CMS=

# Site isolation slug — must match cms_sites.slug
VITE_SITE_SLUG=kocoon-wellness-spa

# Public site URL (SEO canonical / Open Graph)
VITE_SITE_URL=https://kocoon-wellness-spa.vercel.app
